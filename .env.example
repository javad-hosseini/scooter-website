# Copy to .env and fill in. Everything here is read by python-decouple.

# ─── Core ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# REQUIRED in production. ALLOWED_HOSTS used to be ['*'], which disables
# Django's Host-header validation and opens the door to cache poisoning and
# poisoned password-reset links. List the real hostnames, comma separated.
ALLOWED_HOSTS=voltex.ir,www.voltex.ir
CSRF_TRUSTED_ORIGINS=https://voltex.ir,https://www.voltex.ir

# ─── Database ────────────────────────────────────────────────────────────
DB_NAME=voltex
DB_USER=voltex
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ─── Locale ──────────────────────────────────────────────────────────────
# Defaults are fa / Asia/Tehran to match the site's content and <html lang>.
# Set LANGUAGE_CODE=en-us if you want the Django admin in English.
LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran

# ─── SEO / canonical identity ────────────────────────────────────────────
# The origin used for canonical tags, Open Graph URLs, sitemap entries and
# JSON-LD @id values. Set this in production: without it those URLs are built
# from the incoming Host header, so a request that reaches the app over an
# internal hostname or a bare IP emits canonicals pointing at that address.
SITE_URL=https://voltex.ir
SITE_NAME=VOLTEX
SEO_TWITTER_SITE=@voltex

# ─── Organization (Organization JSON-LD on the home page) ────────────────
ORG_LEGAL_NAME=Voltex GmbH
ORG_EMAIL=info@voltex.ir
ORG_PHONE=+98-21-00000000
ORG_FOUNDING_DATE=
# Comma-separated profile URLs -> schema.org sameAs. Leave blank if none.
ORG_SOCIAL_PROFILES=https://instagram.com/voltex,https://t.me/voltex

# ─── Physical showroom (Store JSON-LD on /contact/) ──────────────────────
# Fill these in before relying on local search — an incomplete address is
# worse than none, and the values here must match the Google Business Profile
# and the visible text on the contact page exactly.
STORE_STREET=
STORE_CITY=تهران
STORE_REGION=تهران
STORE_POSTAL_CODE=
STORE_LATITUDE=
STORE_LONGITUDE=
STORE_PRICE_RANGE=$$

# ─── Performance ─────────────────────────────────────────────────────────
# Point at Redis in production so the anonymous page cache is shared between
# workers instead of being duplicated per process.
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1
SEO_PAGE_CACHE_SECONDS=300
COMPRESS_ENABLED=True

# ─── Security ────────────────────────────────────────────────────────────
# Leave SECURE_SSL_REDIRECT on unless TLS is terminated somewhere that does
# not set X-Forwarded-Proto, in which case you will get a redirect loop.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
PREPEND_WWW=False
