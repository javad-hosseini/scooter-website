# ══════════════════════════════════════════════════════════════════════
#  PRODUCTION ENVIRONMENT CONFIGURATION (.env.prod)
#  Copy this file to .env.prod or .env on the server:
#    cp .env.prod.example .env.prod
# ══════════════════════════════════════════════════════════════════════

# Core Django Settings
SECRET_KEY=change-this-to-a-random-50-character-secret-key-in-production
DEBUG=False

# Allowed Domains (comma-separated, without scheme)
ALLOWED_HOSTS=scooterr.ir,www.scooterr.ir,pendar.irandns.com,127.0.0.1,localhost

# CSRF Trusted Origins (comma-separated, with scheme)
CSRF_TRUSTED_ORIGINS=https://scooterr.ir,https://www.scooterr.ir,https://pendar.irandns.com

# ─── Database ─────────────────────────────────────────────────────────
# For PostgreSQL:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=scotehn_scooter
DB_USER=scotehn_user
DB_PASSWORD=your_database_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# If using MySQL / MariaDB instead of PostgreSQL, uncomment these:
# DB_ENGINE=django.db.backends.mysql
# DB_PORT=3306

# ─── Static & Media Paths ─────────────────────────────────────────────
# Default is 'staticfiles' and 'media' inside the project directory.
# If cPanel LiteSpeed serves static files from public/static, uncomment:
# STATIC_ROOT=/home/scotehn/mahta-cycle/public/static
# MEDIA_ROOT=/home/scotehn/mahta-cycle/public/media

# ─── Locale ───────────────────────────────────────────────────────────
LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran

# ─── SEO & Canonical ──────────────────────────────────────────────────
SITE_URL=https://scooterr.ir
SITE_NAME=NeX Go
ORG_LEGAL_NAME=Nex Go
ORG_EMAIL=info@scooterr.ir
ORG_PHONE=+98-21-00000000

# ─── Performance & Caching ───────────────────────────────────────────
COMPRESS_ENABLED=True
SEO_PAGE_CACHE_SECONDS=300

# ─── Security ─────────────────────────────────────────────────────────
# On cPanel / LiteSpeed, SSL redirection is usually handled by LiteSpeed / .htaccess.
# Keep SECURE_SSL_REDIRECT=False to prevent redirect loops unless LiteSpeed passes HTTP_X_FORWARDED_PROTO.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
PREPEND_WWW=False

# ─── Google OAuth (Optional) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
