# ══════════════════════════════════════════════════════════════════════
#  Template for the project's environment files. Committed on purpose —
#  it must never contain a real secret, password, key or token.
#
#  Every value here is a PLACEHOLDER. Replace anything in <angle
#  brackets>; leave a variable blank or commented to accept the default
#  that config/settings.py already defines.
#
#  Setup:
#    cp .env.example .env.dev     # local development (SQLite)
#    cp .env.example .env.prod    # production (PostgreSQL)
#
#  Then pick the environment in config/settings.py by switching the two
#  blocks marked "ENVIRONMENT SWITCH — 1 of 2" and "— 2 of 2".
#  Both .env.dev and .env.prod are gitignored.
# ══════════════════════════════════════════════════════════════════════

# ─── Core ─────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=<generate-a-unique-50-char-random-string>

# True in development only. Never True on a public host: it exposes
# tracebacks, settings and database credentials on any error page.
DEBUG=False

# REQUIRED in production. With DEBUG=False and this unset, Django answers
# every request with HTTP 400. Comma separated, no scheme.
ALLOWED_HOSTS=<your-domain.com>,<www.your-domain.com>
CSRF_TRUSTED_ORIGINS=https://<your-domain.com>,https://<www.your-domain.com>

# ─── Database ─────────────────────────────────────────────────────────
# Only read when the PostgreSQL DATABASES block in settings.py is active.
# The development SQLite block ignores all of these.
DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<database-password>
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ─── Locale ───────────────────────────────────────────────────────────
# Defaults match the site's Persian content and <html lang="fa">.
# Set LANGUAGE_CODE=en-us if you want the Django admin in English.
LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran

# ─── Google OAuth ─────────────────────────────────────────────────────
# Use a separate OAuth client per environment; never reuse the production
# credentials locally.
# without "" or ''
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# ─── SEO / canonical identity ─────────────────────────────────────────
# Origin used for canonical tags, Open Graph URLs, sitemap entries and
# JSON-LD @id values. Without it those URLs are built from the incoming
# Host header, so a request arriving over an internal hostname or a bare
# IP emits canonicals pointing at that address.
#   development: http://127.0.0.1:8000
#   production:  https://<your-domain.com>
SITE_URL=https://<your-domain.com>
SITE_NAME=NeX Go
SEO_TWITTER_SITE=<@handle>

# ─── Organisation (Organization JSON-LD on the home page) ─────────────
ORG_LEGAL_NAME=<Legal Company Name>
ORG_EMAIL=<info@your-domain.com>
ORG_PHONE=<+98-21-00000000>
ORG_FOUNDING_DATE=
# Comma-separated profile URLs -> schema.org sameAs. Blank if none.
ORG_SOCIAL_PROFILES=

# ─── Physical showroom (Store JSON-LD on /contact/) ───────────────────
# Must match the Google Business Profile and the visible text on the
# contact page exactly. An incomplete address is worse than none.
STORE_STREET=
STORE_CITY=تهران
STORE_REGION=تهران
STORE_POSTAL_CODE=
STORE_LATITUDE=
STORE_LONGITUDE=
STORE_PRICE_RANGE=$$

# ─── Performance ──────────────────────────────────────────────────────
# False in development so template edits appear without collectstatic.
COMPRESS_ENABLED=True
SEO_PAGE_CACHE_SECONDS=300
# Point at Redis in production so the anonymous page cache is shared
# between workers instead of duplicated per process.
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# ─── Security ─────────────────────────────────────────────────────────
# Both False/0 in development (plain HTTP on localhost). Turn SSL
# redirect off in production only if TLS terminates somewhere that does
# not set X-Forwarded-Proto, otherwise you get a redirect loop.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
PREPEND_WWW=False
